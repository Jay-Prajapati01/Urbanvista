ista\\Backend\\src\\services\\adminAnalyticsService.js", "source_location": "L314"}, {"caller_nid": "adminanalyticsservice_getdashboardstats", "callee": "all", "source_file": "C:\\Users\\jay19\\Desktop\\6th Sem Sgp\\URBANVISTA\\UrbanVista\\Backend\\src\\services\\adminAnalyticsService.js", "source_location": "L318"}, {"caller_nid": "adminanalyticsservice_getdashboardstats", "callee": "(async () => {\r\n      const activity = await getActivityLogs(filters, { page: 1, limit: 50 });\r\n      const byType = {};\r\n      activity.logs.forEach((row) => {\r\n        byType[row.action] = (byType[row.action] || 0) + 1;\r\n      });\r\n      return {\r\n        total: activity.total,\r\n        byType,\r\n        recent: activity.logs,\r\n      };\r\n    })", "source_file": "C:\\Users\\jay19\\Desktop\\6th Sem Sgp\\URBANVISTA\\UrbanVista\\Backend\\src\\services\\adminAnalyticsService.js", "source_location": "L319"}, {"caller_nid": "adminanalyticsservice_getdashboardstats", "callee": "(async () => {\r\n      const loginStats = await getLoginStats(filters);\r\n      return {\r\n        success: loginStats.successful,\r\n        failed: loginStats.failed,\r\n        blocked: loginStats.blocked,\r\n      };\r\n    })", "source_file": "C:\\Users\\jay19\\Desktop\\6th Sem Sgp\\URBANVISTA\\UrbanVista\\Backend\\src\\services\\adminAnalyticsService.js", "source_location": "L331"}, {"caller_nid": "adminanalyticsservice_getdashboardstats", "callee": "(async () => {\r\n      let paymentQuery = supabase\r\n        .from(\"payment_transactions\")\r\n        .select(\"amount, status, created_at, secretary_id, user_id\")\r\n        .gte(\"created_at\", getDateRange({ ...filters, days: filters.days || 30 }).startIso)\r\n        .order(\"created_at\", { ascending: false });\r\n\r\n      if (filters.userId) {\r\n        paymentQuery = paymentQuery.or(`user_id.eq.${filters.userId},secretary_id.eq.${filters.userId}`);\r\n      }\r\n\r\n      const role = normalizeRole(filters.role);\r\n      if (role === \"secretary\") {\r\n        // Secretary role in payments is represented by secretary_id.\r\n        paymentQuery = paymentQuery.not(\"secretary_id\", \"is\", null);\r\n      }\r\n\r\n      const { data, error } = await paymentQuery;\r\n      if (error) {\r\n        return { total: 0, successful: 0, pending: 0, failed: 0 };\r\n      }\r\n\r\n      const summary = { total: 0, successful: 0, pending: 0, failed: 0 };\r\n      (data || []).forEach((row) => {\r\n        const status = normalizeStatus(row.status || \"pending\") || \"pending\";\r\n        if (status === \"success\") {\r\n          summary.successful += 1;\r\n          summary.total += Number(row.amount || 0);\r\n        } else if (status === \"failed\") {\r\n          summary.failed += 1;\r\n        } else {\r\n          summary.pending += 1;\r\n        }\r\n      });\r\n\r\n      return summary;\r\n    })", "source_file": "C:\\Users\\jay19\\Desktop\\6th Sem Sgp\\URBANVISTA\\UrbanVista\\Backend\\src\\services\\adminAnalyticsService.js", "source_location": "L339"}, {"caller_nid": "adminanalyticsservice_getdashboardstats", "callee": "(async () => {\r\n      const { count } = await supabase\r\n        .from(\"notifications\")\r\n        .select(\"id\", { count: \"exact\", head: true })\r\n        .eq(\"is_read\", false);\r\n      return Number(count || 0);\r\n    })", "source_file": "C:\\Users\\jay19\\Desktop\\6th Sem Sgp\\URBANVISTA\\UrbanVista\\Backend\\src\\services\\adminAnalyticsService.js", "source_location": "L376"}, {"caller_nid": "adminanalyticsservice_getdashboardstats", "callee": "toISOString", "source_file": "C:\\Users\\jay19\\Desktop\\6th Sem Sgp\\URBANVISTA\\UrbanVista\\Backend\\src\\services\\adminAnalyticsService.js", "source_location": "L394"}]}